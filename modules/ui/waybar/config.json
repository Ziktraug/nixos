{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 4,
  "modules-left": [],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "custom/ai-usage",
    "custom/headset",
    "custom/mouse",
    "pulseaudio",
    "custom/gpu",
    "custom/cpu",
    "memory",
    "custom/temp",
    "battery"
  ],
  "clock": {
    "interval": 1,
    "format": "{:%H:%M:%S}",
    "format-alt": "{:%Y-%m-%d %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#89b4fa'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'><b>{}</b></span>",
        "weeks": "<span color='#94e2d5'><b>W{}</b></span>",
        "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
        "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
      }
    }
  },
  "custom/ai-usage": {
    "interval": 30,
    "return-type": "json",
    "exec": "/run/current-system/sw/bin/bash ~/.config/waybar/scripts/ai-usage.sh",
    "escape": false,
    "format": " {}"
  },
  "custom/headset": {
    "interval": 10,
    "return-type": "json",
    "exec": "/run/current-system/sw/bin/bash ~/.config/waybar/scripts/solaar-headset.sh",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "󰋎 {}%"
  },
  "custom/mouse": {
    "interval": 10,
    "return-type": "json",
    "exec": "/run/current-system/sw/bin/bash ~/.config/waybar/scripts/solaar-mouse.sh",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "󰍽 {}%"
  },
  "custom/gpu": {
    "interval": 10,
    "return-type": "json",
    "exec": "/run/current-system/sw/bin/bash ~/.config/waybar/scripts/gpu-info.sh",
    "format": "󰢮 GPU {}%"
  },
  "custom/cpu": {
    "interval": 5,
    "return-type": "json",
    "exec": "/run/current-system/sw/bin/bash ~/.config/waybar/scripts/cpu-info.sh",
    "format": " CPU {}%"
  },
  "memory": {
    "interval": 5,
    "format": " MEM {}%",
    "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G"
  },
  "custom/temp": {
    "interval": 5,
    "return-type": "json",
    "exec": "/run/current-system/sw/bin/bash ~/.config/waybar/scripts/temp-info.sh",
    "format": " TEMP {}°C"
  },
  "battery": {
    "interval": 10,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} BAT {capacity}%",
    "format-charging": " CHG {capacity}%",
    "format-plugged": " AC {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip-format": "{timeTo}, {capacity}%"
  },
  "pulseaudio": {
    "format": "{icon} VOL {volume}%",
    "format-muted": " MUTED",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}