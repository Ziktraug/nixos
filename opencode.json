{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".cursor/rules/*.mdc"
  ],
  "permission": {
    "bash": {
      "./script/check.sh*": "allow",
      "nix search*": "allow",
      "nix-instantiate*": "allow",
      "nix build*": "allow",
      "nix eval*": "allow",
      "nix-store -q*": "allow",
      "nixos-rebuild dry-run*": "allow",
      "hyprctl*": "allow",
      "journalctl*": "allow",
      "waybar*": "allow",
      "systemctl status*": "allow",
      "systemctl --user status*": "allow",
      "systemctl list-*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "grep*": "allow",
      "ls*": "allow",
      "tree*": "allow",
      "mkdir*": "allow",
      "pgrep*": "allow",
      "ss -tlnp*": "allow",
      "find*": "allow",
      "cat*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "readlink*": "allow",
      "*": "ask",
      "rtk ls*": "allow",
      "rtk grep*": "allow",
      "rtk read*": "allow",
      "rtk find*": "allow",
      "rtk tree*": "allow",
      "rtk diff*": "allow",
      "rtk git status*": "allow",
      "rtk git diff*": "allow",
      "rtk git log*": "allow",
      "rtk git show*": "allow",
      "sudo*": "deny",
      "nixos-rebuild switch*": "deny",
      "nixos-rebuild boot*": "deny",
      "nix flake update*": "deny",
      "nix flake lock*": "deny",
      "git add*": "allow",
      "git commit*": "allow",
      "git push*": "deny",
      "rtk git add*": "allow",
      "rtk git commit*": "allow",
      "rtk git push*": "deny",
      "rtk nix flake update*": "deny",
      "rtk nix flake lock*": "deny",
      "rm -rf*": "deny",
      "rm -r*": "deny"
    },
    "read": {
      ".env": "deny",
      ".env.*": "deny",
      "**/secrets/**": "deny",
      "**/credentials/**": "deny"
    }
  }
}
